# Server Configuration
PORT=8000
HOST=127.0.0.1
DEBUG=True

# Database Configuration
DATABASE_URL=sqlite:///./data/phishing_analysis.db

# Machine Learning Settings
ML_MODEL_PATH=ml/best_phishing_model.joblib
VECTORIZER_PATH=ml/tfidf_vectorizer.joblib
USE_HYBRID_DETECTION=True

# Rate Limiting & Security (Defensive settings)
MAX_EMAIL_BODY_LENGTH=50000
RATE_LIMIT_PER_MINUTE=60
SECRET_KEY=change-me-to-a-secure-random-secret-key-in-production
